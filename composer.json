{
  "name": "micx-io/micx-sec-vcs-sdk",
  "type": "library",
  "description": "Queue RPC client for MICX secure VCS",
  "license": "MIT",
  "authors": [
    {
      "name": "Matthias Leuffen",
      "email": "leuffen@continue.de"
    }
  ],
  "autoload": {
    "psr-4": {
      "Micx\\Vcs\\": "src/"
    }
  },
  "require": {
    "php": ">=8.3",
    "ext-json": "*",
    "php-amqplib/php-amqplib": "^3.7"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "suggest": {},
  "config": {
    "preferred-install": "source",
    "allow-plugins": {
      "php-http/discovery": false
    }
  },
  "minimum-stability": "stable",
  "scripts": {
    "test": "phpunit"
  }
}
